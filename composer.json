{
  "name": "idiosyncratic/coding-standard",
  "type": "phpcodesniffer-standard",
  "description": "The Idiosyncratic Coding Standard.",
  "homepage": "https://www.doctrine-project.org/projects/coding-standard.html",
  "license": "MIT",
  "authors": [
    {"name": "Jason Silkey", "email": "jason@jasonsilkey.com"}
  ],
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "discard-changes": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "lock": false
  },
  "require": {
    "php": "^8.4",
    "doctrine/coding-standard": "^14.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
    "slevomat/coding-standard": "^8.26",
    "squizlabs/php_codesniffer": "^4.0"
  }
}
